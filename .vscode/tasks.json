{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Swift: Format repository",
            "type": "process",
            "command": "python3",
            "args": ["${workspaceFolder}/Scripts/swift_style.py", "format"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$swiftc"]
        },
        {
            "label": "Swift: Check repository style",
            "type": "process",
            "command": "python3",
            "args": ["${workspaceFolder}/Scripts/swift_style.py", "check"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$swiftc"]
        },
        {
            "label": "Swift: Build package and tests",
            "type": "process",
            "command": "/usr/bin/xcrun",
            "args": ["swift", "build", "--build-tests"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$swiftc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Swift: Refresh App index (macOS)",
            "type": "process",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/Scripts/configure_vscode_swift.sh", "macos"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$swiftc"],
            "group": "build"
        },
        {
            "label": "Swift: Refresh App index (iOS Simulator)",
            "type": "process",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/Scripts/configure_vscode_swift.sh", "ios"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$swiftc"],
            "group": "build"
        }
    ]
}
